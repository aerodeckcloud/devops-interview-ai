# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# JWT Security (backend)
JWT_SECRET_KEY=replace_with_a_long_random_secret_at_least_32_chars
# Optional: comma-separated previous secrets during key rotation
# JWT_PREVIOUS_SECRET_KEYS=old_key_1,old_key_2
# ENVIRONMENT=development
# Public hostname used by docker-compose.prod.yml. Not needed for local compose.
# SITE_ADDRESS=app.example.com

# Optional Groq Settings (defaults are provided in config.py)
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_TEMPERATURE=0.7
# GROQ_MAX_TOKENS=2048

# Application Settings
# API_HOST=0.0.0.0
# API_PORT=8000
# API_RELOAD=true

# Database Settings
# DATABASE_URL=sqlite+aiosqlite:///./interview_data.db

# Speech Settings
# WHISPER_MODEL=base

# Interview Settings
# MAX_QUESTION_COUNT=10
# SESSION_TIMEOUT=3600

# Voice Agent Runtime (LiveKit)
# VOICE_AGENT_RUNTIME_ENABLED=false
# VOICE_PROVIDER=livekit
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_INTERNAL_URL=ws://livekit:7880
# LIVEKIT_API_KEY=your_livekit_api_key
# LIVEKIT_API_SECRET=your_livekit_api_secret
# LIVEKIT_TOKEN_TTL_SECONDS=3600
# LIVEKIT_ROOM_PREFIX=opsmentorai
# LIVEKIT_AGENT_NAME=ops-mentor-agent
# LIVEKIT_AUTO_DISPATCH=true
# LIVEKIT_DISPATCH_MAX_RETRIES=3
# LIVEKIT_DISPATCH_INITIAL_BACKOFF_SECONDS=0.4
# LIVEKIT_DISPATCH_MAX_BACKOFF_SECONDS=3.0
# LIVEKIT_DISPATCH_BACKOFF_MULTIPLIER=2.0
# WORKER_INTERNAL_API_KEY=replace_with_long_random_shared_key

# LiveKit Voice Worker (realtime STT/LLM/TTS)
# WORKER_AGENT_NAME=ops-mentor-agent
# WORKER_ROOM_PREFIX=opsmentorai
# WORKER_ALLOWED_IDENTITY_PREFIXES=
# WORKER_MAX_TURNS_PER_SESSION=24
# WORKER_MAX_USER_MESSAGE_CHARS=4000
# WORKER_MAX_ASSISTANT_CHARS=1200
# WORKER_MIN_SECONDS_BETWEEN_TURNS=0.8
# WORKER_RATE_LIMIT_WINDOW_SECONDS=20
# WORKER_RATE_LIMIT_MAX_TURNS=8
# WORKER_MAX_REFUSALS_PER_SESSION=6
# WORKER_TELEMETRY_ENABLED=true
# WORKER_ALERT_WEBHOOK_URL=
# WORKER_BACKEND_API_BASE_URL=http://backend:8000/api
# WORKER_INTERNAL_API_KEY=replace_with_long_random_shared_key
# WORKER_ENABLE_PROFANITY_FILTER=true
# WORKER_ENABLE_PROMPT_INJECTION_FILTER=true
# WORKER_ENABLE_OFF_TOPIC_FILTER=true
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# WORKER_LLM_MODEL=qwen/qwen3.8-27b
# WORKER_LLM_TEMPERATURE=0.3
# WORKER_TTS_PROVIDER=auto
# WORKER_STT_PROVIDER=openai
# WORKER_STT_MODEL=whisper-large-v3-turbo
# WORKER_TTS_FAIL_OPEN=true
# WORKER_TTS_MIN_REMAINING_CREDITS=25
# DEEPGRAM_API_KEY=your_deepgram_api_key

# Backend TTS fallback (Piper)
# TTS_PROVIDER=auto
# PIPER_TTS_ENABLED=false
# PIPER_BINARY_PATH=piper
# PIPER_MODEL_PATH=/app/models/en_US-amy-medium.onnx
# PIPER_CONFIG_PATH=/app/models/en_US-amy-medium.onnx.json
# PIPER_SPEAKER_ID=0
# PIPER_LENGTH_SCALE=1.0
# PIPER_NOISE_SCALE=0.667
# PIPER_NOISE_W=0.8
# WORKER_PIPER_SAMPLE_RATE=22050